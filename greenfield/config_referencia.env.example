# ==============================================================================
# PLANTILLA DE REFERENCIA DE VARIABLES DE ENTORNO — PROYECTOS SDD
# ==============================================================================
# Copiar como `.env` en la raíz del proyecto y completar. `.env` NO se versiona
# (debe estar en .gitignore); este archivo de ejemplo sí.
# Los nombres coinciden con los que leen las plantillas de `.sdd/stack/`
# (settings_security_template.py, init_project.py, seed_data.py).
# Los comentarios van en líneas propias: algunos lectores de .env no admiten
# comentarios al final de la línea.
# Ningún valor de este archivo es un secreto real.

# --- ENTORNO Y APLICACIÓN ---
# development | staging | production
APP_ENV=development
APP_NAME="Plataforma Ejemplo"
# Identificador corto de la app; también lo usa el frontend (VITE_APP_SLUG) para
# prefijar las claves de localStorage cuando varias apps comparten dominio.
APP_SLUG=plataforma_ejemplo
DEBUG=True
# Generar uno propio, p. ej.:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"
# La aplicación DEBE negarse a arrancar con DEBUG=False y SECRET_KEY vacía.
SECRET_KEY=<GENERAR_CLAVE_ALEATORIA_DE_50_CARACTERES>

# --- HOSTS Y URLS ---
# Lista explícita, sin comodín '*'. En producción, el dominio real de la app.
ALLOWED_HOSTS=localhost,127.0.0.1,app.ejemplo.local
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- FRONTEND (Vite expone solo variables con prefijo VITE_) ---
VITE_APP_SLUG=plataforma_ejemplo
VITE_API_BASE_URL=http://localhost:8000

# --- SESIÓN Y TOKENS JWT ---
# Access token: vive solo en memoria del frontend; vida corta.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# Refresh token: cookie HttpOnly emitida por POST /api/v1/auth/login/ y rotada por
# POST /api/v1/auth/refresh/ (con lista negra al rotar y al cerrar sesión).
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# HS256 (clave compartida) o RS256 (par de claves; preferible si otro servicio valida tokens)
JWT_SIGNING_ALGORITHM=HS256
REFRESH_COOKIE_NAME=plataforma_ejemplo_refresh
# True en producción (requiere HTTPS)
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
# Limitar la cookie de refresh a la ruta de autenticación
REFRESH_COOKIE_PATH=/api/v1/auth/
# Vacío en localhost; en producción, el dominio exacto de la app
REFRESH_COOKIE_DOMAIN=

# --- MICROSOFT ENTRA ID (antes Azure AD) — SSO OPCIONAL ---
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=<SECRETO_DEL_REGISTRO_DE_APLICACION>
# ID del tenant de la organización ('organizations' admite cualquier cuenta laboral)
AZURE_AD_TENANT_ID=<ID_DEL_TENANT>
# Escribir la URL completa: no todos los lectores de .env expanden ${VARIABLE}
AZURE_AD_REDIRECT_URI=http://localhost:5173/auth/callback
AZURE_AD_SCOPE=openid profile email User.Read

# --- LIMITACIÓN DE INTENTOS (RATE LIMITING) ---
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
# 900 s = 15 minutos de bloqueo temporal
RATE_LIMIT_LOGIN_LOCKOUT_SECONDS=900

# --- REDIS (caché, rate limiting y broker de Celery) ---
REDIS_URL=redis://localhost:6379/1

# --- BASE DE DATOS POSTGRESQL ---
# Las pruebas también corren contra PostgreSQL (no SQLite) para detectar
# diferencias de comportamiento antes de producción.
POSTGRES_DB=plataforma_ejemplo_db
POSTGRES_USER=plataforma_ejemplo
POSTGRES_PASSWORD=<CONTRASEÑA>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- USUARIO ADMINISTRADOR INICIAL (seed_data.py) ---
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_DOC=1000000001
ADMIN_DEFAULT_EMAIL=admin@ejemplo.com
# Cambiarla en el primer ingreso (flujo de primer ingreso obligatorio)
ADMIN_DEFAULT_PASSWORD=<CONTRASEÑA>

# --- CORREO (restablecimiento de contraseña) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-responder@ejemplo.com

# --- VALIDADOR DE ENDPOINTS (pruebas/validate_endpoints.py) ---
# La contraseña del usuario de prueba NO se pasa por argumento.
SDD_LOGIN_PASSWORD=<CONTRASEÑA_USUARIO_DE_PRUEBA>
