# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN UNIVERSAL — ECOSISTEMA GREENYARD
# ==============================================================================
# Este archivo define las variables de entorno canónicas requeridas para levantar
# el módulo de Login y Autenticación en cualquier infraestructura sin suponer rutas fijas.

# --- ENTORNO Y APLICACIÓN ---
APP_ENV=development                       # development | staging | production
APP_NAME=GreenyardPlatform
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-very-long-and-random-secret-key-32-chars

# --- RUTAS DE RED Y HOSTS (PARAMÉTRICOS) ---
ALLOWED_HOSTS=localhost,127.0.0.1,api.greenyard.internal
FRONTEND_URL=http://localhost:5173
BACKEND_API_BASE_URL=http://localhost:8000/api

# --- SEGURIDAD DE SESIÓN Y TOKENS JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60     # Duración del Access Token
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7        # Duración del Refresh Token
JWT_SIGNING_ALGORITHM=HS256              # HS256 o RS256
AUTH_COOKIE_NAME=greenyard_auth_token    # Nombre de la Cookie HttpOnly
AUTH_COOKIE_SECURE=False                 # True en producción (requiere HTTPS)
AUTH_COOKIE_SAMESITE=Lax                 # Lax | Strict | None
AUTH_COOKIE_HTTPONLY=True                # Imprescindible para evitar robo XSS
AUTH_COOKIE_DOMAIN=                      # Dejar vacío para localhost o especificar dominio raíz

# --- MICROSOFT 365 ENTRA ID (AZURE AD SSO) ---
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=your-azure-client-secret-here
AZURE_AD_TENANT_ID=organizations         # O ID del tenant de Greenyard
AZURE_AD_REDIRECT_URI=${FRONTEND_URL}/auth/callback
AZURE_AD_SCOPE=openid profile email User.Read

# --- RATE LIMITING Y PROTECCIÓN FUERZA BRUTA ---
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5          # Intentos antes de bloqueo temporal
RATE_LIMIT_LOGIN_LOCKOUT_SECONDS=900     # 15 minutos de enfriamiento
CACHE_REDIS_URL=redis://localhost:6379/1

# --- BASE DE DATOS (POSTGRESQL / SQLITE) ---
DATABASE_URL=sqlite:///./db.sqlite3      # O postgresql://user:pass@localhost:5432/greenyard_db
